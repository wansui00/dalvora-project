<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#5b3928">
<link rel="manifest" href="/manifest.json">
<title>DALVORA</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#fff8ef;color:#241812;font-family:system-ui,sans-serif}.wrap{max-width:900px;margin:auto;padding:18px}.nav{display:flex;justify-content:space-between;align-items:center;gap:12px}.brand{font-weight:900;letter-spacing:3px;color:#5b3928;flex-shrink:0}.brand small{letter-spacing:1px}.nav-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.btn{border:0;border-radius:10px;padding:11px 15px;font-weight:800;background:#5b3928;color:white;cursor:pointer}.btn:active{transform:translateY(1px)}.hero{padding:35px 0}.hero h1{font-size:clamp(42px,8vw,72px);line-height:.95}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.card{background:white;border:1px solid #eaded3;border-radius:18px;padding:15px}.emoji{font-size:50px;background:#f8dfcc;border-radius:15px;padding:25px;text-align:center;min-height:120px;display:flex;align-items:center;justify-content:center;overflow:hidden}.emoji img{width:100%;height:120px;object-fit:cover;border-radius:12px}.row{display:flex;justify-content:space-between;align-items:center;gap:10px}.price{font-weight:900}.muted{color:#7d6a5e}.box{background:white;border:1px solid #eaded3;border-radius:18px;padding:18px;margin:15px 0}.modal{display:none;position:fixed;z-index:1000;inset:0;background:#0008;align-items:flex-end}.modal.on{display:flex}.sheet{background:#fff8ef;width:100%;max-width:650px;margin:auto;padding:20px;border-radius:22px 22px 0 0;max-height:90vh;overflow:auto}.form{display:grid;gap:9px}.form input,.form textarea,.form select{width:100%;padding:12px;border:1px solid #eaded3;border-radius:10px;font:inherit;background:#fff}.item{padding:10px 0;border-bottom:1px solid #eaded3;display:flex;justify-content:space-between;gap:10px}.empty{text-align:center;padding:15px 0}@media(max-width:650px){.nav{align-items:flex-start}.nav-actions{width:100%;justify-content:flex-start}.grid{grid-template-columns:1fr}.hero{padding-top:25px}}
</style>
</head>
<body>
<div class="wrap">
  <div class="nav">
    <div class="brand">DALVORA<br><small>MORE THAN JUST A DRINK</small></div>
    <div id="navActions" class="nav-actions"></div>
  </div>
  <section class="hero"><div class="muted">KOREAN DRINK • FRESH BEVERAGE</div><h1>Lebih dari sekadar minuman.</h1><p class="muted">Pesan langsung melalui DALVORA.</p></section>
  <h2>Menu</h2>
  <div class="grid" id="products"><p class="muted">Memuat menu...</p></div>
  <div class="box"><b>📱 Pesan langsung di DALVORA</b><p class="muted">Login → pilih menu → checkout → bayar QRIS melalui Midtrans.</p></div>
</div>
<div class="modal" id="m" role="dialog" aria-modal="true" aria-hidden="true"><div class="sheet"><div class="row"><h2 id="title">Login</h2><button type="button" class="btn" onclick="closeM()">✕</button></div><div id="content"></div></div></div>
<script>
let token=localStorage.getItem('dv_token')||'';
let user=safeJson(localStorage.getItem('dv_user'),null);
let cartData=safeJson(localStorage.getItem('dv_cart'),{});
let products=[];
const $=id=>document.getElementById(id);
const rp=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(n)||0);
function safeJson(value,fallback){try{return value?JSON.parse(value):fallback}catch{return fallback}}
function cartTotalQty(){return Object.values(cartData).reduce((sum,q)=>sum+(Number(q)||0),0)}
function authUI(){
  const el=$('navActions');
  const qty=cartTotalQty();
  if(token){
    const nama=(user&&user.name)?user.name:'Akun';
    el.innerHTML=`<button type="button" class="btn" onclick="goHome()">🏠 Beranda</button><button type="button" class="btn" onclick="cart()">🛒 Keranjang <span id="cartCount">${qty}</span></button><button type="button" class="btn" onclick="checkout()">📦 Checkout</button><button type="button" class="btn" onclick="orders()">📋 Pesanan</button><button type="button" class="btn" onclick="(user&&user.role==='admin')?location.href='/admin.html':profile()">${user&&user.role==='admin'?'⚙️ Admin':'👤 '+escapeHtml(nama)}</button><button type="button" class="btn" onclick="logout()">Keluar</button>`;
  }else{
    el.innerHTML=`<button type="button" class="btn" onclick="login()">🔐 Login</button><button type="button" class="btn" onclick="cart()">🛒 Keranjang <span id="cartCount">${qty}</span></button>`;
  }
  update();
}
function escapeHtml(s){return String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function goHome(){closeM();window.scrollTo({top:0,behavior:'smooth'})}
function profile(){
  const nama=(user&&user.name)?user.name:'Pengguna';
  const email=(user&&user.email)?user.email:'';
  modal('Profil',`<div class="form"><p><b>Nama</b><br>${escapeHtml(nama)}</p><p><b>Email</b><br>${escapeHtml(email)}</p><button type="button" class="btn" onclick="logout()">Keluar dari akun</button></div>`);
}
function logout(){
  localStorage.removeItem('dv_token');
  localStorage.removeItem('dv_user');
  cartData={};localStorage.removeItem('dv_cart');
  token='';user=null;
  closeM();authUI();
  alert('Berhasil logout');
}
async function load(){
  try{
    const r=await fetch('/api/products',{cache:'no-store'});
    const data=await r.json();
    if(!r.ok) throw new Error(data.error||'Gagal memuat menu');
    products=Array.isArray(data)?data:[];
    $('products').innerHTML=products.length?products.map(p=>`<div class="card"><div class="emoji">${p.image?`<img src="${escapeHtml(p.image)}" alt="${escapeHtml(p.name)}">`:escapeHtml(p.emoji)}</div><h3>${escapeHtml(p.name)}</h3><p class="muted">${escapeHtml(p.description)}</p><div class="row"><b class="price">${rp(p.price)}</b><div style="display:flex;gap:6px;align-items:center"><button type="button" class="btn" onclick="change(${Number(p.id)},-1)">−</button><b id="q-${Number(p.id)}">${Number(cartData[String(p.id)]||0)}</b><button type="button" class="btn" onclick="change(${Number(p.id)},1)">+</button></div></div></div>`).join(''):'<p class="muted">Menu belum tersedia.</p>';
    cleanCart();update();
  }catch(e){$('products').innerHTML=`<div class="box"><b>Menu gagal dimuat.</b><p class="muted">${escapeHtml(e.message)}</p><button type="button" class="btn" onclick="load()">Coba lagi</button></div>`}
}
function cleanCart(){const valid=new Set(products.map(p=>String(p.id)));for(const id of Object.keys(cartData)){if(!valid.has(id)||Number(cartData[id])<=0)delete cartData[id]}localStorage.setItem('dv_cart',JSON.stringify(cartData))}
function change(id,delta){
  id=String(id);
  const p=products.find(x=>String(x.id)===id);
  if(!p)return;
  const next=(Number(cartData[id])||0)+Number(delta);
  if(next<=0) delete cartData[id]; else cartData[id]=Math.min(99,next);
  save();
  const q=$('q-'+id); if(q) q.textContent=Number(cartData[id]||0);
}
function add(id){change(id,1)}
function save(){localStorage.setItem('dv_cart',JSON.stringify(cartData));update()}
function update(){const qty=cartTotalQty();const top=$('cartCount');if(top)top.textContent=qty}
function modal(t,h){$('title').textContent=t;$('content').innerHTML=h;$('m').classList.add('on');$('m').setAttribute('aria-hidden','false')}
function closeM(){$('m').classList.remove('on');$('m').setAttribute('aria-hidden','true')}
$('m').addEventListener('click',e=>{if(e.target===$('m'))closeM()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeM()});
function login(){modal('Akun',`<div class="form"><input id="email" type="email" autocomplete="email" placeholder="Email"><input id="pass" type="password" autocomplete="current-password" placeholder="Password"><button type="button" class="btn" onclick="doLogin()">Login</button><button type="button" class="btn" onclick="register()">Daftar akun</button></div>`)}
async function doLogin(){
  const email=$('email').value.trim(),password=$('pass').value;
  if(!email||!password)return alert('Email dan password wajib diisi');
  try{const r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password})});const d=await r.json();if(!r.ok)return alert(d.error||'Login gagal');token=d.token;user=d.user;localStorage.setItem('dv_token',token);localStorage.setItem('dv_user',JSON.stringify(user));closeM();authUI();alert('Login berhasil')}catch(e){alert('Tidak dapat terhubung ke server')}}
function register(){modal('Daftar',`<div class="form"><input id="rname" autocomplete="name" placeholder="Nama"><input id="remail" type="email" autocomplete="email" placeholder="Email"><input id="rpass" type="password" autocomplete="new-password" placeholder="Password minimal 6 karakter"><button type="button" class="btn" onclick="doReg()">Buat akun</button></div>`)}
async function doReg(){
  const name=$('rname').value.trim(),email=$('remail').value.trim(),password=$('rpass').value;
  if(!name||!email||password.length<6)return alert('Nama, email, dan password minimal 6 karakter wajib diisi');
  try{const r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,email,password})});const d=await r.json();if(!r.ok)return alert(d.error||'Pendaftaran gagal');token=d.token;user=d.user;localStorage.setItem('dv_token',token);localStorage.setItem('dv_user',JSON.stringify(user));closeM();authUI();alert('Akun dibuat')}catch(e){alert('Tidak dapat terhubung ke server')}}
function cart(){
  const ids=Object.keys(cartData).filter(k=>Number(cartData[k])>0);let total=0;
  let html=ids.length?ids.map(k=>{const p=products.find(x=>String(x.id)===k);const q=Number(cartData[k]);if(!p)return '';total+=p.price*q;return `<div class="item"><div><b>${escapeHtml(p.name)}</b><br><span class="muted">${rp(p.price)} × ${q}</span></div><div style="display:flex;gap:6px;align-items:center"><button type="button" class="btn" onclick="change(${Number(k)},-1);cart()">−</button><b>${q}</b><button type="button" class="btn" onclick="change(${Number(k)},1);cart()">+</button></div></div>`}).join(''):'<p class="muted empty">Keranjang kosong.</p>';
  modal('Keranjang',html+`<h3>Total ${rp(total)}</h3>${ids.length?`<button type="button" class="btn" style="width:100%" onclick="checkout()">Checkout</button>`:''}`)
}

async function orders(){
  if(!token){login();return}
  try{
    const r=await fetch('/api/my-orders',{headers:{Authorization:'Bearer '+token},cache:'no-store'});
    const d=await r.json();
    if(!r.ok) return alert(d.error||'Gagal mengambil pesanan');
    if(!d.length){modal('Pesanan','<p class="muted empty">Belum ada pesanan.</p>');return}
    const statusLabel=s=>({new:'Belum terkirim',processing:'Sedang diproses',shipped:'Sudah terkirim',completed:'Sudah terkirim',cancelled:'Dibatalkan'}[s]||s);
    const html=d.map(o=>`<div class="box"><div class="row"><b>${escapeHtml(o.order_no)}</b><b>${rp(o.total)}</b></div><p>Status pesanan: <b>${statusLabel(o.order_status)}</b><br>Status pembayaran: <b>${escapeHtml(o.payment_status)}</b></p><div>${(o.items||[]).map(i=>`<div class="item"><span>${escapeHtml(i.name)} × ${i.qty}</span><b>${rp(i.price*i.qty)}</b></div>`).join('')}</div><small class="muted">${escapeHtml(o.created_at||'')}</small></div>`).join('');
    modal('Riwayat Pesanan',html);
  }catch(e){alert('Tidak dapat terhubung ke server')}
}

async function ensureSnap(){
  if(window.snap) return true;

  const cfg=await fetch('/api/payment/config').then(r=>r.json());
  if(!cfg.clientKey) throw new Error('Midtrans client key belum tersedia');

  await new Promise((resolve,reject)=>{
    const script=document.createElement('script');
    script.src=cfg.isProduction
      ? 'https://app.midtrans.com/snap/snap.js'
      : 'https://app.sandbox.midtrans.com/snap/snap.js';
    script.setAttribute('data-client-key',cfg.clientKey);
    script.onload=resolve;
    script.onerror=()=>reject(new Error('Gagal memuat Midtrans Snap'));
    document.head.appendChild(script);
  });

  return !!window.snap;
}

function checkout(){
  if(!token) return login();
  const ids=Object.keys(cartData).filter(id=>cartData[id]>0);
  if(!ids.length) return alert('Keranjang masih kosong');

  const nama=user?.name||'';
  modal('Checkout',`
    <div class="form">
      <input id="cn" value="${escapeHtml(nama)}" placeholder="Nama">
      <input id="cp" inputmode="tel" placeholder="WhatsApp">
      <textarea id="ca" placeholder="Alamat"></textarea>
      <select id="pm">
        <option>QRIS</option>
        <option>Transfer Bank</option>
        <option>COD</option>
      </select>
      <button type="button" class="btn" onclick="order()">Buat Pesanan</button>
    </div>
  `);
}
async function order(){
  const name=$('cn').value.trim();
  const phone=$('cp').value.trim();
  const address=$('ca').value.trim();
  const payment_method=$('pm').value;

  if(!name||!phone||!address)
    return alert('Nama, WhatsApp, dan alamat wajib diisi');

  const items=Object.entries(cartData)
    .filter(([id,q])=>Number(q)>0)
    .map(([id,q])=>({
      product_id:Number(id),
      qty:Number(q)
    }));

  try{
    const r=await fetch('/api/orders',{
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'Authorization':'Bearer '+token
      },
      body:JSON.stringify({
        name,
        phone,
        address,
        payment_method,
        items
      })
    });

    const d=await r.json();

    if(!r.ok){
      if(r.status===401){
        token='';
        user=null;
        localStorage.removeItem('dv_token');
        localStorage.removeItem('dv_user');
        authUI();
        return login();
      }
      return alert(d.error||'Pesanan gagal dibuat');
    }

    cartData={};
    save();

    if(d.payment?.provider==='midtrans' && d.payment?.token){
      closeM();

      try{
        await ensureSnap();

        window.snap.pay(d.payment.token,{
          uiMode:'qr',
          onSuccess:function(){
            orders();
          },
          onPending:function(){
            orders();
          },
          onError:function(){
            alert('Pembayaran belum berhasil. Silakan coba lagi.');
            orders();
          },
          onClose:function(){
            orders();
          }
        });
      }catch(e){
        alert('Pembayaran Midtrans gagal dibuka: '+e.message);
      }

      return;
    }

    modal('Pesanan dibuat',`
      <h3>${escapeHtml(d.order_no)}</h3>
      <p>Total ${rp(d.total)}</p>
      <p class="muted">Pesanan berhasil dibuat.</p>
      <button type="button" class="btn" onclick="closeM()">Selesai</button>
    `);

  }catch(e){
    alert('Tidak dapat terhubung ke server');
  }
}
authUI();load();
</script>
</body>
</html>
